# datos: sesiones y atletas son del entrenador, no del repo
data/sessions/
data/athletes/
data/incoming/
data/exploracion/

# lo que se publica a internet: sale del disco de la Mac al desplegar, no del repo.
# Un entrenador que publique veinte swings metería 300 MB en una historia que no se
# borra nunca. Lo que sí va a git es `data/publicados.json`: el registro de qué se
# mandó afuera. Ver `kinelab/tools/publicar.py`.
web/public/demo/

# pesos de modelos: se descargan una vez y se fijan por hash
models/
banco/models/

.DS_Store

# lanzador local del navegador de Claude Code (rutas de esta máquina)
.claude/launch.json

# Los worktrees de los agentes de la cadena caen acá dentro y pesan cientos de
# MB (554 el 20/9, con una sola rama viva). Git no los ignora solo: el
# directorio es del harness, no del repo. Un `git add` que los alcance mete el
# repo dentro del repo.
.claude/worktrees/
